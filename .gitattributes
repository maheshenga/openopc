# The worktree CLI is dense with emoji/box-drawing chars, so git's heuristic
# flags it as binary and hides line diffs. It's plain UTF-8 — treat it as text.
scripts/worktree/*.ts text
*.sh text eol=lf

# Generated snapshots must remain byte-stable across Windows checkouts.
apps/web/public/schema/*.json text eol=lf
packages/starter/src/embedded.generated.json text eol=lf
