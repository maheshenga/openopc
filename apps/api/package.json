{
  "name": "kortix-api",
  "version": "1.0.0",
  "description": "Kortix API - Unified monolith combining router, billing, platform, cron, and daytona-proxy",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenvx run --ignore=MISSING_ENV_FILE -f .env.local -f .env -- bun run --hot src/index.ts",
    "dev:dev-env": "dotenvx run --overload -f .env.dev -- bun run --hot src/index.ts",
    "dev:staging-env": "dotenvx run --overload -f .env.staging -- bun run --hot src/index.ts",
    "dev:prod-env": "dotenvx run --overload -f .env.prod -- bun run --hot src/index.ts",
    "dev:envfile": "bun --env-file=.env.local run --hot src/index.ts",
    "start": "dotenvx run -- bun run src/index.ts",
    "e2e:flow": "bun run scripts/e2e-managed-flow.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-runner.mjs",
    "test:coverage": "node scripts/test-runner.mjs --coverage",
    "test:integration": "node scripts/test-runner.mjs integration",
    "test:live": "node scripts/test-runner.mjs live",
    "test:all": "node scripts/test-runner.mjs all"
  },
  "dependencies": {
    "@daytonaio/sdk": "^0.184.0",
    "@hono/zod-openapi": "^0.19.10",
    "@kortix/api-contract": "workspace:*",
    "@kortix/db": "workspace:*",
    "@kortix/intelligence-contracts": "workspace:*",
    "@kortix/intelligence-orchestration": "workspace:*",
    "@kortix/llm-catalog": "workspace:*",
    "@kortix/llm-gateway": "workspace:*",
    "@kortix/manifest-schema": "workspace:*",
    "@kortix/product-brand": "workspace:*",
    "@kortix/registry": "workspace:*",
    "@kortix/shared": "workspace:*",
    "@kortix/starter": "workspace:*",
    "@kortix/studio-adapters": "workspace:*",
    "@kortix/studio-runtime": "workspace:*",
    "@logtail/node": "^0.5.8",
    "@openopc/module-runtime-contracts": "workspace:*",
    "@scalar/hono-api-reference": "^0.10.20",
    "@sentry/bun": "^10.47.0",
    "@supabase/supabase-js": "^2.95.3",
    "agent-tunnel": "workspace:@kortix/agent-tunnel@*",
    "croner": "^9.0.0",
    "dockerode": "^4.0.4",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "e2b": "2.32.0",
    "hono": "^4.4.0",
    "jose": "^5.9.6",
    "paseto-ts": "2.0.6",
    "postgres": "^3.4.8",
    "semver": "7.8.5",
    "smol-toml": "^1.6.1",
    "stripe": "^14.0.0",
    "yaml": "^2.8.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "@types/dockerode": "^3.3.35",
    "@types/semver": "7.7.1",
    "bun-types": "^1.3.12",
    "typescript": "^5.4.0"
  }
}
