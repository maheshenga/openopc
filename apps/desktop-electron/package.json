{
  "name": "@kortix/desktop-electron",
  "productName": "OpenOPC",
  "version": "0.1.0",
  "private": true,
  "description": "OpenOPC desktop shell — Electron wrapper around the web app",
  "author": "Kortix AI Corp",
  "repository": "https://github.com/kortix-ai/suna",
  "main": "src/main.js",
  "scripts": {
    "build:sidecar": "pnpm --filter @openopc/desktop-agent build:sidecar",
    "setup": "node scripts/ensure-runtime.js && pnpm run build:sidecar",
    "dev": "pnpm run setup && OPENOPC_DESKTOP_URL=http://localhost:3000/projects electron .",
    "dev:dev-env": "pnpm run setup && OPENOPC_DESKTOP_URL=https://dev.kortix.com/projects electron .",
    "dev:prod-env": "pnpm run setup && OPENOPC_DESKTOP_URL=https://kortix.com/projects electron .",
    "test:node": "node --test src/tunnel-profile-store.test.js src/tunnel-pairing.test.js src/tunnel-runtime-supervisor.test.js",
    "test": "pnpm run test:node && bun test ./src",
    "pack": "pnpm run setup && electron-builder --dir",
    "dev:macos": "pnpm run pack && open \"$(find dist -maxdepth 2 -name 'OpenOPC.app' | head -1)\"",
    "build": "pnpm run setup && electron-builder",
    "build:mac": "pnpm run setup && electron-builder --mac",
    "build:win": "pnpm run setup && electron-builder --win",
    "build:linux": "pnpm run setup && electron-builder --linux"
  },
  "devDependencies": {
    "@openopc/desktop-agent": "workspace:*",
    "electron": "^39.8.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
