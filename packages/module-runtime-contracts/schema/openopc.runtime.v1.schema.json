{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openopc.dev/schemas/openopc.runtime.v1.schema.json",
  "title": "OpenOPC runtime descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["descriptorVersion", "runtime"],
  "properties": {
    "descriptorVersion": { "const": 1 },
    "runtime": {
      "oneOf": [{ "$ref": "#/$defs/wasiComponentRuntime" }, { "$ref": "#/$defs/ociImageRuntime" }]
    }
  },
  "$defs": {
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpuMillis", "fuel", "memoryMiB", "outputBytes", "pids", "wallTimeMs"],
      "properties": {
        "cpuMillis": { "type": "integer", "minimum": 1, "maximum": 900000 },
        "fuel": { "type": "integer", "minimum": 1, "maximum": 1000000000000 },
        "memoryMiB": { "type": "integer", "minimum": 16, "maximum": 4096 },
        "outputBytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "pids": { "type": "integer", "minimum": 1, "maximum": 256 },
        "wallTimeMs": { "type": "integer", "minimum": 1, "maximum": 900000 }
      }
    },
    "wasiComponentRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "component", "world", "operation", "imports", "limits"],
      "properties": {
        "kind": { "const": "wasi-component" },
        "component": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9._/-]+$"
        },
        "world": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_.:/@-]+$"
        },
        "operation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "imports": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$"
          }
        },
        "limits": { "$ref": "#/$defs/limits" }
      }
    },
    "ociImageRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "image", "command", "args", "profile", "limits"],
      "properties": {
        "kind": { "const": "oci-image" },
        "image": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "args": {
          "type": "array",
          "maxItems": 128,
          "items": { "type": "string", "maxLength": 4096 }
        },
        "profile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "limits": { "$ref": "#/$defs/limits" }
      }
    }
  }
}
