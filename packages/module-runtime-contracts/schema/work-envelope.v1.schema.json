{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openopc.dev/schemas/work-envelope.v1.schema.json",
  "title": "OpenOPC leased work envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelopeVersion",
    "executionId",
    "accountId",
    "projectId",
    "installationId",
    "idempotencyKey",
    "installRevision",
    "releaseId",
    "releaseDigest",
    "consentRevisionId",
    "permissionDigest",
    "runtimeDescriptorId",
    "runtimeDescriptorDigest",
    "inputDigest",
    "runtimeArtifactDigest",
    "runtimeArtifactBytes",
    "runtimeKind",
    "runtimeProfile",
    "policyDigest",
    "killSwitchGeneration",
    "executionDeadline",
    "bindingDigest",
    "resourceCeilings",
    "lease",
    "grants"
  ],
  "properties": {
    "envelopeVersion": { "const": 1 },
    "executionId": { "$ref": "#/$defs/uuid" },
    "accountId": { "$ref": "#/$defs/uuid" },
    "projectId": { "$ref": "#/$defs/uuid" },
    "installationId": { "$ref": "#/$defs/uuid" },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,254}$"
    },
    "installRevision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "releaseId": { "$ref": "#/$defs/uuid" },
    "releaseDigest": { "$ref": "#/$defs/sha256Digest" },
    "consentRevisionId": { "$ref": "#/$defs/uuid" },
    "permissionDigest": { "$ref": "#/$defs/sha256Digest" },
    "runtimeDescriptorId": { "$ref": "#/$defs/uuid" },
    "runtimeDescriptorDigest": { "$ref": "#/$defs/sha256Digest" },
    "inputDigest": { "$ref": "#/$defs/sha256Digest" },
    "runtimeArtifactDigest": { "$ref": "#/$defs/sha256Digest" },
    "runtimeArtifactBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 33554432
    },
    "runtimeKind": { "enum": ["wasi-component", "oci-image"] },
    "runtimeProfile": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "policyDigest": { "$ref": "#/$defs/sha256Digest" },
    "killSwitchGeneration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "executionDeadline": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "bindingDigest": { "$ref": "#/$defs/sha256Digest" },
    "resourceCeilings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpuMillis", "memoryMiB", "wallTimeMs", "costMicro"],
      "properties": {
        "cpuMillis": { "type": "integer", "minimum": 1, "maximum": 900000 },
        "memoryMiB": { "type": "integer", "minimum": 16, "maximum": 4096 },
        "wallTimeMs": { "type": "integer", "minimum": 1, "maximum": 900000 },
        "costMicro": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      }
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "generation", "deadline"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "generation": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "deadline": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      }
    },
    "grants": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "audience", "tokenHash"],
        "properties": {
          "id": { "$ref": "#/$defs/uuid" },
          "audience": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$"
          },
          "tokenHash": { "$ref": "#/$defs/sha256Digest" }
        }
      }
    }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
