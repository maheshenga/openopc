{
  "name": "@openopc/developer-sdk",
  "version": "0.1.0",
  "description": "OpenOPC SDK for platform-mediated AI and payment capabilities in developer modules.",
  "license": "Elastic-2.0",
  "homepage": "https://github.com/maheshenga/openopc/tree/main/packages/openopc-developer-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maheshenga/openopc.git",
    "directory": "packages/openopc-developer-sdk"
  },
  "keywords": ["openopc", "developer", "sdk", "ai", "payments", "modules"],
  "sideEffects": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "files": ["dist", "README.md", "examples"],
  "scripts": {
    "test": "bun test src",
    "typecheck": "tsc --noEmit && tsc --noEmit -p examples/tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "tsc -p tsconfig.build.json",
    "smoke:install": "node scripts/smoke-install.mjs"
  },
  "publishConfig": {
    "access": "public",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "files": ["dist", "README.md", "examples"]
  },
  "dependencies": { "zod": "^3.23.0" },
  "devDependencies": {
    "@kortix/api-contract": "workspace:*",
    "@types/bun": "^1.3.12",
    "typescript": "^5.4.0"
  }
}
