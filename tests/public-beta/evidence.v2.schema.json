{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openopc.example/schemas/public-beta-evidence.v2.schema.json",
  "title": "OpenOPC Public-Beta Evidence Ledger v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidateCommit",
    "environment",
    "releaseProfileId",
    "releaseProfileDigest",
    "schemaDigest",
    "artifactSetDigest",
    "records"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "candidateCommit": { "$ref": "#/$defs/commit" },
    "environment": { "const": "openopc-public-beta-staging" },
    "releaseProfileId": { "const": "openopc-restricted-public-beta-v1" },
    "releaseProfileDigest": {
      "const": "sha256:e548465c35cb5041b38092b2937164f2abecfb6781ab0e545532ce95f387956c"
    },
    "schemaDigest": { "$ref": "#/$defs/digest" },
    "artifactSetDigest": { "$ref": "#/$defs/digest" },
    "records": {
      "type": "array",
      "minItems": 18,
      "maxItems": 512,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$"
    },
    "stringArray": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "sizeBytes", "mediaType"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "digest": { "$ref": "#/$defs/digest" },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 10737418240 },
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 255 }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "workflow", "runId", "runAttempt"],
      "properties": {
        "repository": { "$ref": "#/$defs/identifier" },
        "workflow": { "type": "string", "minLength": 1, "maxLength": 255 },
        "runId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
        "runAttempt": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "gate",
        "lane",
        "attempt",
        "environment",
        "commit",
        "command",
        "workflow",
        "startedAt",
        "finishedAt",
        "expiresAt",
        "outcome",
        "stagingUrls",
        "dependencyIdentities",
        "artifacts",
        "rawEvidencePaths",
        "resolvesFailureIds",
        "companionEvidenceIds"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "gate": {
          "enum": [
            "G1",
            "G2",
            "G3",
            "G4",
            "G5",
            "G8",
            "G10",
            "G11",
            "G12",
            "B1",
            "B2",
            "B3",
            "B4",
            "B5",
            "B7",
            "B8",
            "B9",
            "B10"
          ]
        },
        "lane": { "type": "string", "pattern": "^public-beta-[gb][0-9]+-[a-z0-9-]+$" },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "environment": { "const": "openopc-public-beta-staging" },
        "commit": { "$ref": "#/$defs/commit" },
        "command": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "workflow": { "$ref": "#/$defs/workflow" },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "outcome": { "enum": ["passed", "failed", "blocked"] },
        "stagingUrls": { "$ref": "#/$defs/stringArray" },
        "dependencyIdentities": { "$ref": "#/$defs/stringArray" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "rawEvidencePaths": { "$ref": "#/$defs/stringArray" },
        "resolvesFailureIds": { "$ref": "#/$defs/stringArray" },
        "companionEvidenceIds": { "$ref": "#/$defs/stringArray" }
      }
    }
  }
}
